# List of the configuration variables, for reference only: no value lives in the repository.
# The values are in Doppler, project projet-iam (dev for local work, prd for Railway).
# Run the app with `doppler run -- python application.py`; never create a .env file.

# Flask Configuration
FLASK_ENV=development
FLASK_APP=application.py
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=projet_ipa

# Connection Pool Settings
DB_POOL_SIZE=5
DB_POOL_NAME=iam_pool

# Application Settings
AUTOCOMPLETE_LIMIT=6
MAX_IDENTITY_DOCUMENT_BYTES=5242880

GROQ_API_KEY=your_groq_api_key_here

# SMTP settings for prescriber account approvals
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# Health data encryption at rest (required in production).
# Generate with: python -m app.services.vault
# DATA_ENCRYPTION_KEYS: first key seals new data; keep old keys after it during a rotation.
DATA_ENCRYPTION_KEYS=
DATA_INDEX_KEY=

# Prescribers local time offset from UTC, in hours (Benin: 1, no daylight saving)
APP_UTC_OFFSET_HOURS=1

# Idle time before the session locks, in minutes (ticket 17)
SESSION_IDLE_LOCK_MINUTES=10

# Two-factor authentication required for prescribers (pilot: false, before sale: true)
TWO_FACTOR_REQUIRED=false
